# ===========================================
# Omnichannel Headless Service Configuration
# ===========================================
# Copy this file to .env and fill in your values

# Omnichannel Configuration (Required)
# Get these from Dynamics 365 > Customer Service Hub > Chat Widget settings
OMNI_ORG_URL=https://your-org.omnichannelengagementhub.com
OMNI_ORG_ID=your-org-id-guid
OMNI_WIDGET_ID=your-widget-id-guid
OMNI_CPS_BOT_ID=your-bot-id-guid

# Server Configuration
PORT=3001
HOST=0.0.0.0
NODE_ENV=production

# CORS Configuration
# Set to your frontend URL in production, * for development
CORS_ORIGIN=*
