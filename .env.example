# ===========================================
# Omnichannel Headless Service Configuration
# ===========================================
# Copy this file to .env and fill in your values

# Omnichannel Configuration (Required)
# Get these from Dynamics 365 > Customer Service Hub > Chat Widget settings
OMNI_ORG_URL=https://your-org.omnichannelengagementhub.com
OMNI_ORG_ID=your-org-id-guid
OMNI_WIDGET_ID=your-widget-id-guid

# CPS Bot ID (Optional)
# Required if using Copilot Studio bot integration
OMNI_CPS_BOT_ID=your-bot-id-guid

# Server Configuration
PORT=3001
HOST=0.0.0.0
NODE_ENV=production

# CORS Configuration
# Set to your frontend URL in production, * for development
CORS_ORIGIN=*

# Debug Mode
# Set to 'true' for verbose browser console logging
DEBUG=false

# ===========================================
# Frontend Configuration (Vite)
# ===========================================
# These are used by the React frontend

VITE_API_URL=http://localhost:3001
VITE_WS_URL=ws://localhost:3001/ws

# Legacy frontend env vars (kept for backward compatibility)
VITE_OMNI_ORG_URL=https://your-org.omnichannelengagementhub.com
VITE_OMNI_ORG_ID=your-org-id-guid
VITE_OMNI_WIDGET_ID=your-widget-id-guid
VITE_OMNI_CPS_BOT_ID=your-bot-id-guid
